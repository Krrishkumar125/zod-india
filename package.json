{
  "name": "zod-india",
  "version": "0.4.0",
  "description": "Zod schemas for Indian formats: GSTIN, PAN, IFSC, UPI, Aadhaar, PIN, with checksums and ₹ lakh/crore formatting.",
  "license": "MIT",
  "author": "Krrish Kumar (https://github.com/Krrishkumar125)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krrishkumar125/zod-india.git"
  },
  "homepage": "https://github.com/Krrishkumar125/zod-india#readme",
  "bugs": {
    "url": "https://github.com/Krrishkumar125/zod-india/issues"
  },
  "keywords": [
    "zod",
    "india",
    "validation",
    "gstin",
    "pan",
    "ifsc",
    "upi",
    "aadhaar",
    "pincode",
    "inr",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./validators": {
      "import": {
        "types": "./dist/validators.d.ts",
        "default": "./dist/validators.js"
      },
      "require": {
        "types": "./dist/validators.d.cts",
        "default": "./dist/validators.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:zod3": "vitest run --config vitest.zod3.config.ts",
    "check:exports": "publint && attw --pack . --profile node16",
    "test:smoke": "node test/smoke.mjs"
  },
  "peerDependencies": {
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12",
    "zod": "^4.6.7",
    "zod3": "npm:zod@^3.25.76"
  }
}
